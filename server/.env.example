# AarogyaMP — Environment Template for Self-Hosted Deployment
# Copy to .env and fill in the values marked CHANGE_ME
# No external API keys needed when using Docker Compose (Ollama + ntfy are self-hosted)

# ── Server ─────────────────────────────────────────────────────
PORT=8000
CORS_ORIGINS=*

# ── Database (auto-configured by docker-compose) ───────────────
DATABASE_URL=postgresql+psycopg://aarogya:aarogya@postgres:5432/aarogyamp

# ── Auth ───────────────────────────────────────────────────────
# CHANGE THIS to a random 32+ character string before sharing!
JWT_SECRET=CHANGE_ME_BEFORE_PRODUCTION
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# ── Storage ────────────────────────────────────────────────────
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# ── LLM — Local Ollama (auto-configured by docker-compose) ─────
# These are set automatically by docker-compose.yml
# Override here ONLY if running outside Docker
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:70b-instruct-q4_K_M

# ── Model Selection ─────────────────────────────────────────────
# This ONE line controls which AI model runs. Change it based on your machine:
#
# Default (MacBook 16GB / Server): OLLAMA_MODEL=llama3.1:8b                  (~4.7GB, 2-5s)
# Ultra-fast dev / small laptops:  OLLAMA_MODEL=llama3.2:3b-instruct         (~2GB, 1-3s)
# Server 64GB (production):        OLLAMA_MODEL=llama3.1:70b-instruct-q4_K_M (~40GB, clinical depth)
# Server 128GB (multilingual):     OLLAMA_MODEL=qwen2.5:72b-instruct-q8_0    (~80GB, Hindi/regional)
OLLAMA_MODEL=llama3.1:8b

LLM_TIMEOUT_SECONDS=120

# ── Push Notifications — ntfy (auto-configured by docker-compose) ──
# For external access, set this to your server's public IP or domain
NTFY_BASE_URL=http://localhost:8080
# Legacy FCM — not used, kept as migration hook
FCM_SERVER_KEY=

# ── Ops / Admin ────────────────────────────────────────────────
# CHANGE THIS before sharing!
ADMIN_OPS_TOKEN=CHANGE_ME_BEFORE_PRODUCTION

# ── Speech-to-Text ─────────────────────────────────────────────
STT_PROVIDER=device   # device = on-device STT in Flutter app (no server cost)
